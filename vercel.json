{
  "buildCommand": "python3 build_inject_tokens.py",
  "rewrites": [
    {
      "destination": "/index.html",
      "source": "/vancouver"
    },
    {
      "destination": "/index.html",
      "source": "/vancouver/store/:placeId"
    },
    {
      "destination": "/cctest/index.html",
      "source": "/cctest"
    },
    {
      "destination": "/test/index.html",
      "source": "/test"
    }
  ]
}
